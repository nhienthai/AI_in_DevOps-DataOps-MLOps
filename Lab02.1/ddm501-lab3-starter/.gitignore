# Type checking
.mypy_cache/

# Models (large files)
models/*.pkl
!models/.gitkeep

# Data
# Anchored with a leading slash: a bare `data/` also matches tests/data/, which
# would silently drop the entire data-test package from the repository.
/data/
*.csv

# Logs
*.log

# Docker
.docker/

# OS
.DS_Store
Thumbs.db

# Pre-commit
.pre-commit-config.yaml.bak
